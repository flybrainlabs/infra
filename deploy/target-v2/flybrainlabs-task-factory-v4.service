[Unit]
Description=flybrainlabs Devnet contract task transport and serial full-model verifier
After=network-online.target flybrainlabs-wallet-mining-v3.service
Wants=network-online.target flybrainlabs-wallet-mining-v3.service

[Service]
Type=simple
User=flypow
Group=flypow
WorkingDirectory=/opt/flypow/task-factory-v4/current
ExecStart=/opt/flypow/runtime/node/bin/node --max-old-space-size=192 /opt/flypow/task-factory-v4/current/tools/factory_service_v4.mjs /etc/flypow/task-factory-v4-runtime.json
Restart=on-failure
RestartSec=15
TimeoutStopSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/flypow/task-factory-v4
CPUQuota=100%
Nice=10
IOWeight=50
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
